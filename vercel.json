{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/articles/(.*)/",
      "destination": "/articles/$1",
      "permanent": true
    },
    {
      "source": "/blogs/(.*)/",
      "destination": "/blogs/$1",
      "permanent": true
    },
    {
      "source": "/features/(.*)/",
      "destination": "/features/$1",
      "permanent": true
    },
    {
      "source": "/compare/(.*)/",
      "destination": "/compare/$1",
      "permanent": true
    },
    {
      "source": "/comparisons/(.*)/",
      "destination": "/comparisons/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:ico|png|jpg|jpeg|svg|webp|xml|txt))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|images/|api/|data/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
